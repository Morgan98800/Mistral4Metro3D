# =============================================================================
# Variables d'environnement — GlobalMetro3D
# Copiez ce fichier en `.env.local` (Netlify Functions) ou `.env` (local).
# Sans clé d'API, les relais répondent en mode dégradé (horaires GTFS théoriques).
# =============================================================================

# --- Relais temps réel (Netlify Functions, dossier netlify/functions/) ---

# Paris — IDFM PRIM SIRI-Lite (https://prim.iledefrance-mobilites.fr/)
PRIM_API_KEY=your_prim_api_key_here
# Cadence de rafraîchissement amont du relais PRIM (secondes, défaut 180)
PRIM_POLL_INTERVAL_SECONDS=180

# Montréal — STM i3
STM_API_KEY=your_stm_api_key_here
# Origin déclaré auprès de l'API STM (défaut : URL du site en production)
STM_ORIGIN=https://parisian3dsubway.netlify.app

# Londres — TfL Unified API (app_key, https://api.tfl.gov.uk)
TFL_APP_KEY=your_tfl_app_key_here

# Washington DC — WMATA GTFS-RT (clé facultative, https://developer.wmata.com)
WMATA_API_KEY=your_wmata_api_key_here

# Lille (Ilévia GTFS-RT) et Berlin (VBB GTFS-RT) : flux ouverts, aucune clé requise.

# --- CORS des relais /api/* ---
# Origines autorisées supplémentaires, séparées par des virgules.
# Par défaut : URL Netlify du site (URL, DEPLOY_URL, DEPLOY_PRIME_URL) + localhost.
# Aucun wildcard `*` n'est jamais émis.
# ALLOWED_ORIGINS=https://exemple.com,https://autre.exemple

# --- Engine local (dossier engine/, service optionnel sur le port 4000) ---
PORT=4000
HOST=0.0.0.0
RT_POLL_BUDGET_PER_MIN=20
